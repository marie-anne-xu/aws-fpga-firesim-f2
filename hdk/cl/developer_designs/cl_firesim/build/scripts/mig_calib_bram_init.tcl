# Apply to the (single) cl_ddr4 calibration MicroBlaze BRAM set in the current design.
proc pr_apply_mig_bram_init {} {
    set cells [get_cells -quiet -hier -filter {PRIMITIVE_GROUP == BLOCKRAM && NAME =~ *u_ddr_cal_riu/mcs0/*}]
    if {[llength $cells] != [dict size $::PR_MIG_BRAM_INIT]} {
        error "PR: expected [dict size $::PR_MIG_BRAM_INIT] DDR calibration BRAMs, found [llength $cells]"
    }
    set byrel [dict create]
    foreach c $cells {
        set n [get_property NAME $c]
        set i [string first inst/u_ddr4_mem_intfc $n]
        dict set byrel [string range $n $i end] $c
    }
    set n 0
    dict for {rel pv} $::PR_MIG_BRAM_INIT {
        if {![dict exists $byrel $rel]} { error "PR: DDR calibration BRAM not found: $rel" }
        set c [dict get $byrel $rel]
        dict for {p v} $pv { set_property $p $v $c; incr n }
    }
    puts "PR: replayed $n DDR calibration BRAM INIT properties on [llength $cells] cells"
}
